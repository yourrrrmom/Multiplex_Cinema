<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="model.SearchController">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Πάνω μέρος: Τίτλος και Πεδίο Αναζήτησης -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Αναζήτηση Προβολών:">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <TextField fx:id="searchField" prefWidth="300.0" promptText="Πληκτρολόγησε τίτλο ταινίας..." />
    </HBox>

    <!-- Μεσαίο μέρος: Πίνακας με τις Προβολές -->
    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <!-- Τα fx:id εδώ είναι που συνδέονται με τον Controller μας -->
            <TableColumn fx:id="titleColumn" prefWidth="250.0" text="Τίτλος Ταινίας" />
            <TableColumn fx:id="timeColumn" prefWidth="100.0" text="Ώρα" />
            <TableColumn fx:id="roomColumn" prefWidth="120.0" text="Αίθουσα" />
            <TableColumn fx:id="seatsColumn" prefWidth="130.0" text="Διαθέσιμες Θέσεις" />
        </columns>
    </TableView>

    <!-- Κάτω μέρος: Κουμπί Συνέχειας (Στοιχισμένο δεξιά) -->
    <HBox alignment="CENTER_RIGHT">
        <!-- Το onAction="#handleProceed" λέει ότι όταν πατηθεί, θα τρέξει η μέθοδος handleProceed στον Controller -->
        <Button fx:id="btnProceed" mnemonicParsing="false" onAction="#handleProceed" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Επιλογή &amp; Πλάνο Θέσεων">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
        </Button>
    </HBox>

</VBox>