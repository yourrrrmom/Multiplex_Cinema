<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="model.SeatingController" 
      alignment="CENTER" spacing="20"
      minWidth="600" minHeight="400">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Επιλογή Θέσεων" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <GridPane fx:id="seatGrid" alignment="CENTER" hgap="5" vgap="5"/>
    
    <HBox alignment="CENTER" spacing="15.0">
        <Button text="Πίσω" onAction="#handleBack" />
        <Button text="Επιβεβαίωση" onAction="#handleConfirm"/>
    </HBox>
    
</VBox>
